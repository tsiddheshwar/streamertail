{
  "name": "streamertail",
  "version": "0.4.0",
  "description": "Streamertail — a lightweight, framework-agnostic CSS utility library with theme support",
  "main": "dist/streamertail.css",
  "style": "dist/streamertail.css",
  "exports": {
    ".": "./dist/streamertail.css",
    "./core": "./dist/core.css",
    "./colors": "./dist/colors.css",
    "./layouts": "./dist/layouts.css",
    "./animations": "./dist/animations.css",
    "./tokens": "./dist/tokens/index.mjs",
    "./tokens/json": "./dist/tokens/tokens.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-tokens.js",
    "build:css": "vite build",
    "build:tokens": "node scripts/build-tokens.js",
    "dev": "vite build --watch",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "css",
    "utility",
    "theme",
    "dark-mode",
    "typography",
    "buttons",
    "forms",
    "grid",
    "flexbox",
    "animations",
    "design-tokens",
    "lightweight",
    "framework-agnostic"
  ],
  "license": "MIT",
  "author": "Siddheshwar Tekale",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsiddheshwar/streamertail.git"
  },
  "homepage": "https://github.com/tsiddheshwar/streamertail#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "postcss": "^8.4.38",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^9.5.0",
    "cssnano": "^7.0.0",
    "rimraf": "^5.0.0",
    "sass": "^1.77.0",
    "vite": "^5.4.0"
  }
}
